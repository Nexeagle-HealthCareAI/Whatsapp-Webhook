# For local dev only. On the VM, .env is generated by the deploy workflow
# from GitHub Actions secrets — copy this for local dev, never commit .env.

WHATSAPP_TOKEN=<permanent access token from Meta>
WHATSAPP_PHONE_NUMBER_ID=<from Meta App dashboard>
WHATSAPP_VERIFY_TOKEN=<your own random string, set during webhook setup>
WHATSAPP_APP_SECRET=<from Meta App dashboard, used for HMAC verification>
REDIS_PASSWORD=<generate with: openssl rand -hex 24>

# Authenticates 1HMS/1Rad's push calls to POST /events/token-called (app/webhook.py) —
# a separate secret from WHATSAPP_APP_SECRET, which authenticates Meta instead.
# Generate with: openssl rand -hex 24
INTERNAL_EVENTS_TOKEN=<shared secret, given to the 1HMS team to send as X-Internal-Token>
WHATSAPP_FLOW_ID=1534474454316152


# See sql/schema.sql — this bot's own DB, not easyHMSAPI's.
SQLSERVER_CONN_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=host.docker.internal,1433;DATABASE=WhatsAppBookingDev;UID=<user>;PWD=<password>;TrustServerCertificate=yes
HMS_API_BASE_URL=https://1hms-dev-api.nexeagle.com
HMS_API_KEY=<optional — leave blank for anonymous access>
