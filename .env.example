# For local dev only. On the VM, .env is generated by the deploy workflow
# from GitHub Actions secrets — copy this for local dev, never commit .env.

WHATSAPP_TOKEN=<permanent access token from Meta>
WHATSAPP_PHONE_NUMBER_ID=<from Meta App dashboard>
WHATSAPP_VERIFY_TOKEN=<your own random string, set during webhook setup>
WHATSAPP_APP_SECRET=<from Meta App dashboard, used for HMAC verification>
REDIS_PASSWORD=<generate with: openssl rand -hex 24>

# Authenticates 1HMS/1Rad's push calls to POST /events/token-called (app/webhook.py) —
# a separate secret from WHATSAPP_APP_SECRET, which authenticates Meta instead.
# Generate with: openssl rand -hex 24
INTERNAL_EVENTS_TOKEN=<shared secret, given to the 1HMS team to send as X-Internal-Token>

# Patient-details Flow -- NOT portable between Meta Apps/WABAs. Each app needs its own Flow
# built in that app's WhatsApp Manager (name/age/gender/guardian/slot fields matching
# _send_patient_details_flow in app/conversation/__init__.py), or every send fails with
# "flow_id is invalid" the moment a patient reaches that step.
WHATSAPP_FLOW_ID=<this app's own Flow id, from WhatsApp Manager>
WHATSAPP_FLOW_SCREEN_ID=REGISTRATION_SCREEN

# Dialable number for wa.me/<number> click-to-chat links -- NOT the same as
# WHATSAPP_PHONE_NUMBER_ID above (that's Meta's internal Cloud API id, never dialable).
# Used by GET /c/{hospital_code}. Optional -- leave unset until you're ready to print QR
# codes; that route degrades to a friendly error instead of crashing the bot.
WHATSAPP_DISPLAY_NUMBER=<E.164 format, e.g. 91XXXXXXXXXX, no leading +>


# See sql/schema.sql — this bot's own DB, not easyHMSAPI's.
SQLSERVER_CONN_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=host.docker.internal,1433;DATABASE=WhatsAppBookingDev;UID=<user>;PWD=<password>;TrustServerCertificate=yes
HMS_API_BASE_URL=https://1hms-dev-api.nexeagle.com
HMS_API_KEY=<optional — leave blank for anonymous access>
# See app/listener/model_config.py -- GROK_API_KEY is PRIMARY_NLU (grok-4), SARVAM_API_KEY
# is FALLBACK_NLU, tried only if Grok has no key configured or its call fails.
GROK_API_KEY=<your xAI/Grok api key>
SARVAM_API_KEY=<your sarvam api key>
GEMINI_API_KEY=<your gemini api key>
